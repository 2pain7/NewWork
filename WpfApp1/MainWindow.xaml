<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="332.889" Width="419.026">
    <Grid>
        <TabControl Margin="0,0,0,-2">
            <TabItem Margin="-2,-2,-30,0" Header="Имя" Background="LightBlue">
                <StackPanel>
                    <TextBlock Text="Введите имя:" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Name:" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBox Name="Name" Width="271" ToolTip="Введите ваше имя здесь..." />
                    </StackPanel>
                    <Button Content="Ввод" Click="SubmitButton_Click" Margin="40,10,46,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Margin="30,-2,-57,0" Header="Текст" Background="LightBlue">
                <StackPanel>
                    <TextBlock Text="Введите текст:" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Текст" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBox Name="NameTextBox" Width="311" ToolTip="Введите ваш текст здесь..." Height="52" FontSize="{Binding ElementName=Sliders, Path=Value}" />
                    </StackPanel>
                    <Button Content="Сохранить" Margin="94,10,106,0" Click="Button_Click"/>
                    <Slider x:Name="Sliders" Height="32" Margin="56,0,53,0" Value="5" Minimum="1" Maximum="20"/>
                </StackPanel>
            </TabItem>
            <TabItem Margin="57,-2,-77,0" RenderTransformOrigin="0.5,0.5" Header="Картинка" Background="LightBlue">
                <Grid>
                    <Image x:Name="img1" Margin="27,15,200,11" Grid.ColumnSpan="2"/>
                    <Button Content="Загрузить картинку" HorizontalAlignment="Left" Margin="237,65,0,0" VerticalAlignment="Top" Width="125" Height="31" Click="Button_Click_1"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
